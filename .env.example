# Copy to .env.local for local development, and add the same variables in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Never prefix these with REACT_APP_ (that would ship them to the browser).

# Pick ONE provider. If both are set, Gemini is used unless CHAT_PROVIDER=anthropic.

# Google Gemini (key from https://aistudio.google.com/apikey, has a free tier)
GEMINI_API_KEY=your-gemini-key-here
# Optional: pin one model. Default tries gemini-3.5-flash, then gemini-3.1-flash-lite, then gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude (key starts with sk-ant-)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CHAT_MODEL=claude-haiku-5-5
